# ---- compose ----
COMPOSE_PROJECT_NAME=partfit

# ---- database (PostgreSQL 16) ----
DB_NAME=partfit_db
DB_USER=partfit_user
DB_PASSWORD=partfit_pwd
DB_HOST=db
DB_PORT=17743
POSTGRES_DB=partfit_db
POSTGRES_USER=partfit_user
POSTGRES_PASSWORD=partfit_pwd

# ---- ports ----
FRONTEND_PORT=18243
BACKEND_PORT=19243

# ---- auth ----
JWT_SECRET=partfit_dev_jwt_secret_change_me_in_prod_1112
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# ---- infra ----
REDIS_URL=redis://redis:6379/0
WAREHOUSE_ARTIFACT_DIR=/data/warehouse
WAREHOUSE_CATALOG=lantu_ads

# ---- cost model (CNY) ----
COST_PER_GIB_CNY=0.30
MONTHLY_QUERY_DAYS=30
QUERY_VOLUME_SCALE=5
COST_CURRENCY=CNY
DEFAULT_MONTHLY_BUDGET_CNY=1800
DEFAULT_WARN_RATIO=0.75
DEFAULT_CRITICAL_RATIO=0.92

# ---- limits ----
RATE_WINDOW_SECONDS=60
RATE_WINDOW_MAX=240
ESTIMATE_INLINE=false

# ---- demo seed ----
SEED_DEMO=true
